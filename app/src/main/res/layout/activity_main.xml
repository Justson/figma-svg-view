<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <io.github.justson.figmasvg.FigmaSvgView
        android:id="@+id/figmaSvgView"
        android:layout_width="match_parent"
        android:layout_height="358dp"
        android:contentDescription="@null"
        app:figmaSvgScaleType="fit_xy"
        app:figmaSvgSource="@raw/background" />

    <!-- path / transform / evenodd / arc 的验证画面 -->
    <io.github.justson.figmasvg.FigmaSvgView
        android:id="@+id/shapesView"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        app:figmaSvgScaleType="fit_center"
        app:figmaSvgSource="@raw/shapes" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/demo_title"
            android:textColor="#31152A"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/demo_subtitle"
            android:textColor="#72576A"
            android:textSize="15sp" />

        <Button
            android:id="@+id/switchSourceButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/show_json" />
    </LinearLayout>
</FrameLayout>
